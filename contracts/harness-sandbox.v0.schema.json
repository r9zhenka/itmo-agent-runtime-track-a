            "path"
          ],
          "additionalProperties": false
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        }
      },
      "required": [
        "v",
        "op",
        "session_id",
        "operation_id",
        "tool",
        "arguments",
        "timeout_s"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
