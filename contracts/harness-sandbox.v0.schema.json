        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "enum": [
            "ro",
            "rw"
          ]
        }
      },
      "required": [
        "v",
        "op",
        "session_id",
        "workspace",
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "exec"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "tool": {
          "const": "RunCommand"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        }
      },
      "required": [
        "v",
        "op",
        "session_id",
        "operation_id",
        "tool",
        "arguments",
        "timeout_s"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "exec"
        },
