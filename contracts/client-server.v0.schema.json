{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Client requests v0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "create"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "enum": [
            "ro",
            "rw"
          ]
        }
      },
      "required": [
        "v",
        "op",
        "request_id",
        "workspace",
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "message"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      },
      "required": [
        "v",
        "op",
        "session_id",
        "request_id",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "collect"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      "required": [
        "v",
        "op",
        "session_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "cancel"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      "required": [
        "v",
        "op",
        "session_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 0,
          "type": "integer"
        },
        "op": {
          "const": "release"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      "required": [
        "v",
        "op",
        "session_id"
      ],
      "additionalProperties": false
    }
  ]
}
